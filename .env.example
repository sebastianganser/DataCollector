# Bitget API Credentials
# Leave empty if you only want to access public data
BG_API_KEY=
BG_SECRET_KEY=
BG_PASSPHRASE=

# PostgreSQL Database Credentials
# Use the unraid host IP if running within docker but connecting to host DB
DB_HOST=192.168.1.x 
DB_PORT=5432
DB_NAME=crypto_data
DB_USER=postgres
DB_PASSWORD=secret

# Storage Paths (Optional - Defaults shown below)
# These map to locations INSIDE the container. 
# Use Docker volumes to map them to your host.
STORAGE_PATH_INPUT=./data/input
STORAGE_PATH_OUTPUT=./data/output
STORAGE_PATH_ARCHIVE=./data/archiv
STORAGE_PATH_FEEDBACK=./data/feedback
